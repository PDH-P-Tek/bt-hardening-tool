# =====================================================================
#  BT Hardening Tool — .gitignore
#
#  These rules are a safety net, not the control. The control is the
#  secret-exclusion test (SPEC.md §10.1), which runs in CI on every
#  commit and is not optional: no credential material, no live estate
#  data, no collected state in the tree.
# =====================================================================

# --- Drop-box for content produced outside the repo -------------------
# Documents written into the OneDrive reference copy rather than into
# this tree. Untracked, so a pull in that copy leaves it alone. Move
# things out of here into the tree deliberately; nothing in it is ever
# committed.
_inbox/

# --- Live range material: never committed ---------------------------
data/
baselines/
collected/
estates/
*.pcap
*.cap

# Real firewall configuration. Fixtures are hand-built and sanitised,
# and are the only XML permitted in the tree.
*.xml
!tests/fixtures/**/*.xml
!examples/**/*.xml

# --- Credentials and keys -------------------------------------------
# The monitor's key pair is generated by the operator at setup and
# lives outside this repository. Nothing here should ever exist.
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
known_hosts
authorized_keys
secrets.yaml
secrets.yml
.env
.env.*
!.env.example

# --- Monitor working state (contains live estate detail) ------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Logs and scratch ------------------------------------------------
*.log
logs/
tmp/
scratch/

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# --- Container --------------------------------------------------------
.docker/
*.tar

# --- Editors ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---------------------------------------------------------------
# desktop.ini and Zone.Identifier appear because a reference clone of
# this repo lives in a OneDrive-synced folder.
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
