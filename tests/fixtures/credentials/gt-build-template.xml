<?xml version="1.0"?>
<!--
  SYNTHETIC-TEST-CREDENTIAL-NOT-REAL

  Reproduces the SHAPE of a shipped build template, from the real one, with every
  credential-bearing value invented and the certificate and private key omitted
  entirely. Team 42 addressing throughout.

  Three things here that earlier fixtures got wrong, and that the code had to change
  to handle:

    - floating rules bind to <interface>any</interface>, not a comma-separated list
    - the account password is <sha512-hash>, not <bcrypt-hash>
    - <authorizedkeys> is base64-encoded, so read as plain text it is one blob and
      every key on the box is invisible

  Also present and deliberately preserved: SNMP with a public community string, a
  NOPASSWD sudo grant, the FRR package password, and the BFD peers on fd81:25 while
  the Routers alias lists fd81:10 — which is F1.
-->
<pfsense>
    <version>23.3</version>
    <system>
        <hostname>fw1</hostname>
        <domain>do.42.dcm.ex</domain>
        <dnsserver>10.181.0.11</dnsserver>
        <dnsserver>10.181.0.12</dnsserver>
        <group><name>admins</name><scope>system</scope><member>0</member><member>2000</member></group>
        <user>
            <name>admin</name>
            <scope>system</scope>
            <groupname>admins</groupname>
            <sha512-hash>$6$synthetic$NotARealHashAtAllInventedForTestsOnly000000000</sha512-hash>
            <authorizedkeys>ZnJvbT0iMTAuMC4wLjUiIHNzaC1lZDI1NTE5IEFBQUFDM056YUMxbFpESTFOVEU1VTFOVFUxTlRVMU5UVTFOVFUxTlRVMU5UVTFOVFUxTlRVMU5UVTFOVFUxTT0gZ3RAYnVpbGQK</authorizedkeys>
            <uid>0</uid>
        </user>
        <user>
            <name>gt</name>
            <scope>user</scope>
            <sha512-hash>$6$synthetic$AlsoInventedNotARealHashEitherAtAll00000000000</sha512-hash>
            <uid>2000</uid>
        </user>
        <webgui><protocol>https</protocol><noantilockout></noantilockout></webgui>
        <disablenatreflection>yes</disablenatreflection>
        <ssh><enable>enabled</enable></ssh>
        <sshguard_whitelist>25.42.0.0/16 198.19.42.0/24 172.16.0.0/12</sshguard_whitelist>
    </system>
    <interfaces>
        <wan><enable></enable><if>vmx1</if><descr><![CDATA[bt_wan_do]]></descr>
            <ipaddr>25.42.0.10</ipaddr><subnet>24</subnet>
            <ipaddrv6>fd81:25:42::10</ipaddrv6><subnetv6>64</subnetv6></wan>
        <lan><enable></enable><if>vmx2</if><descr><![CDATA[do_ws]]></descr>
            <ipaddr>25.42.9.1</ipaddr><subnet>24</subnet>
            <ipaddrv6>fd81:25:42:9::1</ipaddrv6><subnetv6>64</subnetv6></lan>
        <opt1><enable></enable><if>vmx3</if><descr><![CDATA[do_svrs]]></descr>
            <ipaddr>25.42.10.1</ipaddr><subnet>24</subnet>
            <ipaddrv6>fd81:25:42:10::1</ipaddrv6><subnetv6>64</subnetv6></opt1>
        <opt2><enable></enable><if>vmx0</if><descr><![CDATA[do_dmz]]></descr>
            <ipaddr>25.42.11.1</ipaddr><subnet>24</subnet>
            <ipaddrv6>fd81:25:42:11::1</ipaddrv6><subnetv6>64</subnetv6></opt2>
    </interfaces>
    <snmpd><rocommunity>public</rocommunity></snmpd>
    <syslog><filterdescriptions>1</filterdescriptions></syslog>
    <filter>
        <rule><type>pass</type><ipprotocol>inet46</ipprotocol><direction>any</direction>
            <floating>yes</floating><interface>any</interface>
            <statetype><![CDATA[keep state]]></statetype><protocol>tcp/udp</protocol>
            <source><any></any></source><destination><any></any><port>53</port></destination>
            <descr></descr></rule>
        <rule><type>pass</type><ipprotocol>inet46</ipprotocol><direction>any</direction>
            <floating>yes</floating><interface>any</interface>
            <statetype><![CDATA[keep state]]></statetype><protocol>udp</protocol>
            <source><any></any></source><destination><any></any><port>123</port></destination>
            <descr></descr></rule>
        <rule><type>pass</type><ipprotocol>inet46</ipprotocol><direction>any</direction>
            <floating>yes</floating><interface>any</interface>
            <statetype><![CDATA[keep state]]></statetype><protocol>icmp</protocol>
            <icmptype>any</icmptype>
            <source><any></any></source><destination><any></any></destination>
            <descr></descr></rule>
        <rule><type>pass</type><interface>wan</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><address>Remote_Access</address></source><destination><any></any></destination>
            <descr><![CDATA[VPN access for exercise participants]]></descr></rule>
        <rule><type>pass</type><interface>wan</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><address>Routers</address></source><destination><network>(self)</network></destination>
            <descr><![CDATA[Routing information exchange]]></descr></rule>
        <rule><type>pass</type><interface>wan</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><network>(self)</network></source><destination><any></any></destination>
            <descr><![CDATA[Firewall outbound traffic]]></descr></rule>
        <rule><type>pass</type><interface>wan</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><any></any></source><destination><any></any></destination>
            <descr></descr></rule>
        <rule><type>pass</type><interface>lan</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><any></any></source><destination><any></any></destination><descr></descr></rule>
        <rule><type>pass</type><interface>opt1</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><any></any></source><destination><any></any></destination><descr></descr></rule>
        <rule><type>pass</type><interface>opt2</interface><ipprotocol>inet46</ipprotocol>
            <statetype><![CDATA[keep state]]></statetype>
            <source><any></any></source><destination><any></any></destination><descr></descr></rule>
        <separator>
            <floatingrules></floatingrules>
            <wan></wan><lan></lan><opt1></opt1><opt2></opt2>
        </separator>
    </filter>
    <aliases>
        <alias><name>Routers</name><type>host</type>
            <address>25.42.0.1 25.42.0.2 25.42.0.3 fd81:10:42::1 fd81:10:42::2 fd81:10:42::3</address>
            <descr><![CDATA[Blue Team edge routers r1 and r2]]></descr></alias>
        <alias><name>Remote_Access</name><type>network</type>
            <address>172.21.31.0/24 fd81:172:21:31::/64 198.18.128.0/24 fd81:198:18:128::/64 198.19.42.0/24 fd81:198:19:42::/64 172.21.28.0/24 fd81:172:21:28::/64 172.21.29.0/24 fd81:172:21:29::/64</address>
            <descr><![CDATA[Remote access from BT, GT, and WT VPN]]></descr></alias>
    </aliases>
    <installedpackages>
        <sudo><config>
            <row><username><![CDATA[user:gt]]></username><runas>user:root</runas>
                <nopasswd>ON</nopasswd><cmdlist>ALL</cmdlist></row>
        </config></sudo>
        <frr><config><enable>on</enable>
            <password><![CDATA[SyntheticPackagePassword]]></password></config></frr>
        <frrbfdpeers>
            <config><peer>25.42.0.1</peer></config>
            <config><peer>25.42.0.2</peer></config>
            <config><peer>fd81:25:42::1</peer></config>
            <config><peer>fd81:25:42::2</peer></config>
        </frrbfdpeers>
        <frrospfd><config><routerid>25.42.0.10</routerid></config></frrospfd>
    </installedpackages>
    <nat><outbound><mode>disabled</mode></outbound></nat>
</pfsense>
