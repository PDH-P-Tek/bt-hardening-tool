<?xml version="1.0"?>
<!--
  SYNTHETIC-TEST-CREDENTIAL-NOT-REAL

  A pfSense configuration carrying the material a real one carries, so the monitor's
  adapter can be proved to drop it rather than assumed to. Every value is invented.

  This file lives here because the secret-exclusion test caught it inline in a test
  module, which is the control doing its job: credential-shaped material belongs in
  the one directory that announces itself as synthetic.
-->
<pfsense>
  <version>23.3</version>
  <system>
    <noantilockout></noantilockout>
    <user>
      <name>admin</name>
      <uid>0</uid>
      <scope>system</scope>
      <bcrypt-hash>$2y$10$SyntheticHashThatMustNeverBeStoredAnywhereAtAll0000000</bcrypt-hash>
      <authorizedkeys>from="10.0.0.5" ssh-ed25519 QUFBQUJCQkJDQ0NDRERERA== ops@laptop</authorizedkeys>
    </user>
    <group><name>admins</name><scope>system</scope><member>0</member></group>
  </system>
  <aliases>
    <alias><name>Mgmt_Sources</name><type>network</type>
      <address>198.51.100.0/24 203.0.113.0/24</address></alias>
  </aliases>
  <filter>
    <rule><tracker>1699900001</tracker><type>pass</type><interface>wan</interface>
      <ipprotocol>inet46</ipprotocol><source><any></any></source>
      <destination><any></any></destination><descr>VPN access</descr></rule>
  </filter>
  <nat><outbound><mode>disabled</mode></outbound></nat>
</pfsense>
