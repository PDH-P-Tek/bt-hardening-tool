<?xml version="1.0"?>
<!--
  SYNTHETIC-TEST-CREDENTIAL-NOT-REAL

  Every value below is invented for this test and corresponds to nothing. The
  file exists so the parser can be proved to drop credential material rather
  than merely be assumed to: SPEC.md section 10.2 requires a fixture containing
  hashes and keys to produce no output or persisted state containing them.

  It is the one path exempt from the secret-exclusion scan, and the exemption is
  guarded: every file in this directory must carry the marker above, so a real
  secret cannot be dropped here quietly.

  Source configurations carry all of this alongside the three sections the tool
  reads. That is why only <aliases>, <filter> and <nat> are ever parsed.
-->
<pfsense>
  <version>23.3</version>
  <system>
    <hostname>fw1</hostname>
    <user>
      <name>admin</name>
      <bcrypt-hash>$2y$10$SyntheticNotARealHashAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</bcrypt-hash>
      <authorizedkeys>c3NoLWVkMjU1MTkgU1lOVEhFVElDLU5PVC1BLVJFQUwtS0VZLUZPUi1URVNUUw==</authorizedkeys>
    </user>
    <webgui>
      <protocol>https</protocol>
      <private-key>-----BEGIN PRIVATE KEY-----
U1lOVEhFVElDLU5PVC1BLVJFQUwtS0VZLUZPUi1URVNUUy1PTkxZLU5PVEhJTkct
SEVSRS1JUy1BLVNFQ1JFVC1JVC1JUy1BTEwtSU5WRU5URUQtRk9SLVRIRS1TVUlU
-----END PRIVATE KEY-----</private-key>
    </webgui>
  </system>
  <snmpd>
    <rocommunity>public</rocommunity>
  </snmpd>
  <installedpackages>
    <frr>
      <config>
        <password>SyntheticServicePassword1</password>
      </config>
    </frr>
  </installedpackages>
  <aliases>
    <alias>
      <name>Remote_Access</name>
      <type>network</type>
      <address>198.19.42.0/24</address>
      <descr>Remote access ranges</descr>
    </alias>
  </aliases>
  <filter>
    <rule>
      <tracker>1699930001</tracker>
      <type>pass</type>
